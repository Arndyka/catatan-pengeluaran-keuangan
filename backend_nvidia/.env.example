# Copy menjadi .env untuk penggunaan lokal.
# Jangan commit file .env.

NVIDIA_API_KEY=nvapi-GANTI_DENGAN_KEY_BARU
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Text-only model untuk merapikan hasil OCR/parser lokal.
NVIDIA_TEXT_MODEL=deepseek-ai/deepseek-v4-pro

# Multimodal model untuk endpoint optional /api/nvidia/read-page.
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

ALLOWED_ORIGINS=https://arndyka.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_CANDIDATES_PER_REQUEST=50
